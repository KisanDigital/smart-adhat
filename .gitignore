# Smart Adhat - Git Ignore Configuration
# Created: November 29, 2025

# ============================================
# Documentation Files
# ============================================
# Ignore all markdown files
*.md

# But keep README files
!README.md
!**/README.md

# ============================================
# Node.js / Angular Frontend
# ============================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs
dist/
tmp/
out-tsc/
/frontend/dist/
/frontend/tmp/
/frontend/out-tsc/

# Angular specific
.angular/
.sass-cache/
/frontend/.angular/

# IDEs and Editors
/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# OS specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Testing
/coverage
*.lcov
.nyc_output

# Environment variables
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# Java / Maven / Spring Boot Backend
# ============================================

# Compiled class files
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven
/backend/target/
/backend/pom.xml.tag
/backend/pom.xml.releaseBackup
/backend/pom.xml.versionsBackup
/backend/pom.xml.next
/backend/release.properties
/backend/dependency-reduced-pom.xml
/backend/buildNumber.properties
/backend/.mvn/timing.properties
/backend/.mvn/wrapper/maven-wrapper.jar

# Gradle (if used)
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Spring Boot
/backend/spring-boot-*.log
/backend/*.log
/backend/logs/

# H2 Database files (dev)
*.db
*.mv.db
*.trace.db

# ============================================
# Docker
# ============================================
docker-compose.override.yml

# ============================================
# Logs and temporary files
# ============================================
*.log
logs/
*.pid
*.seed
*.pid.lock
lib-cov
.grunt
.lock-wscript
build/Release
.npm
.eslintcache
.node_repl_history
.yarn-integrity

