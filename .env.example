# Smart Adhat - Environment Variables Template
# Copy this file to .env and update with your values

# ============================================
# Database Configuration (for docker-compose.prod.yml)
# ============================================

# PostgreSQL Password - CHANGE THIS!
POSTGRES_PASSWORD=smartadhat_secure_password_change_me

# ============================================
# Security Configuration
# ============================================

# JWT Secret - MUST BE BASE64 ENCODED AND AT LEAST 256 BITS
# Generate with: echo -n "your-secret-key" | base64
# Or PowerShell: [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes("your-secret-key"))
JWT_SECRET=c21hcnRhZGhhdHNlY3JldGtleWZvcmp3dHRva2VuZ2VuZXJhdGlvbjIwMjU=

# ============================================
# CORS Configuration
# ============================================

# Allowed origins for CORS (comma-separated)
# For production, update with your domain
CORS_ORIGINS=http://localhost,http://localhost:4200,http://localhost:80

# ============================================
# Server Configuration (Optional)
# ============================================

# Server port (default: 8080)
# SERVER_PORT=8080

# ============================================
# Database Configuration (Optional - for external database)
# ============================================

# If you're connecting to an external PostgreSQL database:
# DATABASE_URL=jdbc:postgresql://your-db-host:5432/smartadhat
# DATABASE_USERNAME=smartadhat_user
# DATABASE_PASSWORD=your_password

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 1. Never commit the .env file to version control
# 2. Use strong passwords (minimum 16 characters)
# 3. Generate a unique JWT secret for production
# 4. Update CORS_ORIGINS with your actual domain
# 5. Keep this file secure and backed up separately

