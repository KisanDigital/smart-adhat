option_settings:
  # Use spot instances for cost savings
  - namespace: aws:ec2:instances
    option_name: SpotFleetOnDemandBase
    value: "0"
  - namespace: aws:ec2:instances
    option_name: SpotFleetOnDemandAboveBasePercentage
    value: "0"
  - namespace: aws:ec2:instances
    option_name: EnableSpot
    value: "true"
  - namespace: aws:ec2:instances
    option_name: SpotMaxPrice
    value: "0.0104"
  - namespace: aws:ec2:instances
    option_name: InstanceTypes
    value: "t3.micro, t3a.micro, t2.micro"

  # Single instance environment
  - namespace: aws:elasticbeanstalk:environment
    option_name: EnvironmentType
    value: "SingleInstance"

  # Instance profile
  - namespace: aws:autoscaling:launchconfiguration
    option_name: IamInstanceProfile
    value: "aws-elasticbeanstalk-ec2-role"
  - namespace: aws:autoscaling:launchconfiguration
    option_name: SecurityGroups
    value: "default"

  # Health check settings
  - namespace: aws:elasticbeanstalk:application
    option_name: Application Healthcheck URL
    value: "/api/health"

  # Environment properties
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: SERVER_PORT
    value: "5000"
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: SPRING_PROFILES_ACTIVE
    value: "aws"
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: JWT_SECRET
    value: "c21hcnRhZGhhdHNlY3JldGtleWZvcmp3dHRva2VuZ2VuZXJhdGlvbjIwMjU="
